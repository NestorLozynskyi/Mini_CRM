# Скопіюйте у .env і змініть значення. Файл .env не комітиться.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=minicrm
POSTGRES_USER=minicrm
POSTGRES_PASSWORD=change-me
# Порт PostgreSQL на 127.0.0.1 хоста (для dev-запуску бекенду поза Docker)
POSTGRES_HOST_PORT=5433

# --- Caddy ---
# Локально ":80"; на VPS — доменне ім'я (напр. crm.example.com) для автоматичного HTTPS
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8448

# --- Захист демо-режиму від зловживань ---
APP_DEMO_PER_IP_LIMIT=10
APP_DEMO_MAX_ACTIVE=2000

# --- Бекенд при запуску поза Docker (./gradlew bootRun) ---
# SERVER_PORT=8080
# DB_URL=jdbc:postgresql://localhost:5433/minicrm
# DB_USERNAME=minicrm
# DB_PASSWORD=change-me
